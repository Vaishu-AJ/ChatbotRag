# Copy this file to .env and add your OpenAI API key.
OPENAI_API_KEY=replace_with_your_new_api_key

# Local, no-API-billing mode is the default.
RAG_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=gemma3:4b

# Optional OpenAI API models (paid API usage).
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local project paths
PDF_DIRECTORY=data/documents
VECTOR_STORE_DIRECTORY=data/vector_store
OKF_DIRECTORY=data/okf

# Optional PostgreSQL access. Use a database role granted SELECT only.
# Encode reserved URL characters in credentials (for example, @ as %40).
DATABASE_URL=postgresql://readonly_user:replace_me@localhost:5432/your_database

# Certificate file service. Set a token only if the file endpoint requires bearer auth.
DATABASE_MEDIA_BASE_URL=http://localhost:9083/api/v1/crew/
DATABASE_MEDIA_TOKEN=
