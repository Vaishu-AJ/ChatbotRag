# Copy this file to .env and add your OpenAI API key.
OPENAI_API_KEY=replace_with_your_new_api_key

# Local, no-API-billing mode is the default.
RAG_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional OpenAI API models (paid API usage).
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local project paths
PDF_DIRECTORY=data/documents
VECTOR_STORE_DIRECTORY=data/vector_store
